:root { --bg: #fcf8fc; --card: #fff; --tx: #1f2937; --mu: #6b7280; --pr: #6d2f66; --pr2: #fff; --bd: #e9d3e6; --soft: #f5e8f3; color-scheme: light; box-sizing: border-box; padding-top: env(safe-area-inset-top,0px); padding-bottom: env(safe-area-inset-bottom,0px); }

