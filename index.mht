}

:root[data-theme="dark"] { --bg: #170f17; --card: #221522; --tx: #f5eef5; --mu: #b9a5b9; --pr: #d58bc8; --pr2: #2a0f27; --bd: #4a2f4a; --soft: #311f31; color-scheme: dark; }

* { box-sizing: border-box; }

body { margin: 0px; background: var(--bg); color: var(--tx); font-family: "Hind Siliguri", system-ui, sans-serif; line-height: 1.6; }

body::before { content: ""; position: fixed; inset: 0px 0px auto; height: env(safe-area-inset-top,0px); background: var(--card); z-index: 11; }

a { color: inherit; text-decoration: none; }

.lg { height: 46px; border-radius: 8px; display: block; }

.bn { display: flex; align-items: center; }

.w { max-width: 1100px; margin: 0px auto; padding: 0px 16px; }

#hdr { position: sticky; top: env(safe-area-inset-top,0px); z-index: 10; background: var(--card); border-bottom: 1px solid var(--bd); }

.ann { background: var(--pr); color: var(--pr2); text-align: center; padding: 4px 8px; font-size: 14px; }

.hb { display: flex; justify-content: space-between; align-items: center; max-width: 1100px; margin: 0px auto; padding: 8px 16px; }

.bn { font-size: 24px; font-weight: 700; color: var(--pr); letter-spacing: 0.5px; }

.ci { font-size: 22px; position: relative; padding: 4px 8px; }

.ci b { background: var(--pr); color: var(--pr2); border-radius: 10px; font-size: 12px; padding: 0px 6px; position: absolute; top: -4px; right: -4px; }

.nv { display: flex; gap: 4px; overflow-x: auto; max-width: 1100px; margin: 0px auto; padding: 0px 12px 6px; white-space: nowrap; }

.nv a { padding: 4px 12px; border-radius: 16px; font-size: 15px; }

.nv a:hover { background: var(--soft); }

.btn { display: inline-block; background: var(--pr); color: var(--pr2); border: 0px; border-radius: 10px; padding: 10px 20px; font-style: inherit; font-variant: inherit; font-stretch: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; font-weight: 700; font-size: 16px; cursor: pointer; }

.btn.g { background: var(--soft); color: var(--tx); }

h1 { font-size: 28px; margin: 8px 0px; }

h2 { font-size: 24px; margin: 32px 0px 14px; display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }

h2 .all { font-size: 15px; color: var(--pr); font-weight: 600; }

.sl { position: relative; height: clamp(200px, 42vw, 380px); border-radius: 16px; overflow: hidden; margin-top: 16px; }

.sl a { position: absolute; inset: 0px; opacity: 0; transition: opacity 0.6s; }

.sl a.on { opacity: 1; }

.sl img { width: 100%; height: 100%; object-fit: cover; }

.cap { position: absolute; left: 0px; right: 0px; bottom: 0px; padding: 20px; background: linear-gradient(transparent, rgba(0, 0, 0, 0.6)); color: rgb(255, 255, 255); display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }

.cap b { font-size: 22px; }

.tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }

.tile { position: relative; border-radius: 14px; overflow: hidden; aspect-ratio: 1 / 1; background: var(--soft); }

.tile img { width: 100%; height: 100%; object-fit: cover; }

.tile span { position: absolute; left: 0px; right: 0px; bottom: 0px; background: rgba(0, 0, 0, 0.55); color: rgb(255, 255, 255); text-align: center; padding: 6px; font-weight: 600; }

.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; }

.p { background: var(--card); border: 1px solid var(--bd); border-radius: 14px; padding: 10px; display: flex; flex-direction: column; gap: 6px; }

.p img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 10px; }

.p h3 { margin: 0px; font-size: 17px; }

.pr { font-weight: 700; font-size: 19px; color: var(--pr); }

.pr s { color: var(--mu); font-weight: 400; font-size: 14px; margin-left: 6px; }

.pr.big { font-size: 26px; }

.p .btn { margin-top: auto; padding: 8px; }

.flash { background: var(--soft); border-radius: 16px; padding: 0px 14px 16px; margin-top: 28px; }

.flash h2 { margin-top: 0px; padding-top: 16px; }

.cd { background: var(--pr); color: var(--pr2); border-radius: 8px; padding: 2px 10px; font-size: 16px; }

.rv { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 8px; }

.rc { min-width: 240px; max-width: 260px; background: var(--card); border: 1px solid var(--bd); border-radius: 14px; padding: 12px; }

.rc img { width: 100%; border-radius: 10px; margin-bottom: 6px; }

.rc p { margin: 4px 0px; color: var(--mu); font-size: 15px; }

.why { list-style: none; padding: 0px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; }

.why li { background: var(--card); border: 1px solid var(--bd); border-radius: 10px; padding: 10px 14px; }

.why li::before { content: "✅ "; }

.chips { display: flex; gap: 8px; flex-wrap: wrap; margin: 12px 0px; }

.chips a { background: var(--soft); border-radius: 16px; padding: 4px 14px; }

.chips a.on { background: var(--pr); color: var(--pr2); }

.det { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-top: 20px; }

.det img { width: 100%; border-radius: 16px; }

.box { background: var(--card); border: 1px solid var(--bd); border-radius: 14px; padding: 18px; margin: 16px 0px; }

label { display: block; font-weight: 600; margin: 10px 0px 4px; }

input, textarea, select { width: 100%; padding: 10px 12px; border: 1px solid var(--bd); border-radius: 8px; background: var(--bg); color: var(--tx); font: inherit; }

.q { display: flex; align-items: center; gap: 12px; }

.q button { width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--bd); background: var(--bg); color: var(--tx); font-size: 20px; cursor: pointer; }

.q b { min-width: 24px; text-align: center; font-size: 18px; }

.row { display: flex; justify-content: space-between; gap: 8px; padding: 4px 0px; }

.tot { border-top: 2px solid var(--bd); margin-top: 8px; padding-top: 8px; font-weight: 700; font-size: 20px; }

.ln { display: flex; gap: 12px; align-items: center; border-bottom: 1px solid var(--bd); padding: 10px 0px; }

.ln img { width: 64px; height: 64px; object-fit: cover; border-radius: 8px; }

.ln > div { flex: 1 1 0%; }

.err { color: rgb(220, 38, 38); font-size: 14px; min-height: 20px; }

.ct { display: flex; gap: 10px; flex-wrap: wrap; }

footer { background: var(--card); border-top: 1px solid var(--bd); margin-top: 40px; padding: 24px 0px; font-size: 15px; color: var(--mu); }

footer b { color: var(--tx); }

#toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); background: var(--tx); color: var(--bg); padding: 10px 20px; border-radius: 20px; z-index: 20; display: none; }

#edbtn { position: fixed; right: 12px; bottom: 16px; z-index: 12; }

#ed { display: none; border: 2px dashed var(--pr); margin: 20px auto; max-width: 1068px; }

.edg { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0px 12px; }

.ep { border-top: 1px solid var(--bd); padding: 10px 0px; }

.ep img { width: 70px; height: 70px; object-fit: cover; border-radius: 8px; }

.ep label.ck { display: inline-flex; gap: 6px; align-items: center; margin-right: 14px; }

.ep label.ck input { width: auto; }

.bdg { display: inline-block; padding: 2px 10px; border-radius: 12px; font-weight: 700; font-size: 14px; background: var(--bg); border: 1px solid var(--bd); }

.ord { border-top: 1px solid var(--bd); padding: 10px 0px; font-size: 15px; }

.st { display: flex; gap: 16px; flex-wrap: wrap; margin: 8px 0px; }

.st div { background: var(--bg); border-radius: 8px; padding: 8px 14px; text-align: center; }
